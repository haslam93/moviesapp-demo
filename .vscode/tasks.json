{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Cinemademoapp: API dev server",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev"
			],
			"group": "build"
		},
		{
			"label": "Cinemademoapp: UI dev server",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev"
			],
			"options": {
				"cwd": "${workspaceFolder}/client"
			},
			"group": "build"
		}
	]
}